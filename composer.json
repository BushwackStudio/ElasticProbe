{
  "name": "bushwack/elasticprobe",
  "description": "Supercharge your WordPress search with ElasticSearch® precision.",
  "type": "wordpress-plugin",
  "keywords": ["wordpress", "plugin", "elasticsearch", "elasticprobe", "search"],
  "license": ["GPL-2.0-only"],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Nima Shayanfar",
      "email": "nshayanfar@gmail.com"
    },
    {
      "name": "Bushwack Studio",
      "homepage": "https://elasticprobe.com"
    }
  ],
  "repositories": [
    {
      "type":"composer",
      "url":"https://wpackagist.org"
    }
  ],
  "require": {
    "php": ">=7.4",
    "composer/installers": "^1.0 || ^2.0",
    "psr/container": "1.0.0"
  },
  "require-dev": {
    "10up/phpcs-composer": "dev-trunk",
    "wpackagist-plugin/woocommerce":"*",
    "phpcompatibility/phpcompatibility-wp": "*",
    "brianhenryie/strauss": "^0.21.0",
    "yoast/phpunit-polyfills": "^4.0",
    "phpunit/phpunit": "^9.0.0",
    "php-stubs/wordpress-tests-stubs": "*"
  },
  "scripts": {
    "lint": "phpcs . -s --runtime-set testVersion 7.4-",
    "lint-fix": "phpcbf .",
    "test": "phpunit --testdox",
    "test-single-site": "phpunit -c single-site.xml.dist --testdox",
    "setup-local-tests": "bash bin/install-wp-tests.sh wp_test wordpress 1234 127.0.0.1 latest true",
    "strauss": [ "vendor/bin/strauss" ],
    "post-install-cmd": [
      "@strauss"
    ],
    "post-update-cmd": [
      "@strauss"
    ]
  },
  "extra": {
    "installer-paths": {
      "vendor/{$name}/": ["type:wordpress-plugin", "type:wordpress-theme"]
    },
    "strauss": {
      "target_directory": "vendor-prefixed",
      "namespace_prefix": "ElasticProbe\\Vendor_Prefixed\\",
      "classmap_prefix": "ElasticProbe_Vendor_Prefixed_",
      "constant_prefix": "WPP_VENDOR_"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
